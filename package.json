{
  "name": "pokemon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "gen": "DEBUG=true gql-gen --config ./config/codegen.yml",
    "prettier": "prettier --check './src/**/*.tsx'",
    "fix-prettier:staged": "prettier --write --loglevel warn",
    "fix-prettier": "prettier --write './src/**/*.tsx' --loglevel warn",
    "eslint": "eslint -c .eslintrc.js './src/**/*.tsx'",
    "fix-eslint:staged": "eslint --fix -c .eslintrc.js",
    "fix-eslint": "eslint --fix -c .eslintrc.js './src/**/*.tsx'",
    "eslint-validate": "eslint --no-ignore --max-warnings=0 --fix -c .eslintrc.js './src/**/!(*.test).tsx'",
    "fix": "yarn fix-prettier && yarn fix-eslint"
  },
  "lint-staged": {
    "src/**/!(*.test).tsx": [
      "yarn fix-prettier:staged",
      "yarn fix-eslint:staged",
      "git add"
    ]
  },
  "devDependencies": {
    "@apollo/client": "^3.5.10",
    "@graphql-codegen/typescript": "^2.4.8",
    "@graphql-codegen/typescript-operations": "^2.3.5",
    "@graphql-codegen/typescript-react-apollo": "^3.2.11",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^13.0.0",
    "@testing-library/user-event": "^13.2.1",
    "@types/jest": "^27.0.1",
    "@types/node": "^16.7.13",
    "@types/react": "^18.0.5",
    "@types/react-dom": "^18.0.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/styled-components": "^5.1.25",
    "@typescript-eslint/eslint-plugin": "^5.19.0",
    "@typescript-eslint/parser": "^5.19.0",
    "eslint": "^8.13.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-react": "^7.29.4",
    "eslint-plugin-react-hooks": "^4.4.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "prettier": "^2.6.2",
    "styled-components": "^5.3.5"
  },
  "dependencies": {
    "graphql": "^16.3.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router-dom": "^5.3.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.4.2",
    "web-vitals": "^2.1.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
